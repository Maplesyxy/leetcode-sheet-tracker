{
  "manifest_version": 3,
  "name": "LeetCode Sheet Tracker",
  "version": "1.0.0",
  "description": "Automatically logs your LeetCode submissions, session time, and weak topics to a Google Sheet.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "alarms", "idle"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "LeetCode Sheet Tracker"
  },
  "options_ui": { "page": "src/options.html", "open_in_tab": true }
}
